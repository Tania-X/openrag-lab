# OpenRAG 服务地址
OPENRAG_BASE_URL=http://localhost:3000
OPENRAG_API_KEY=orag_your_api_key_here

# 默认知识库/过滤配置（后续按实际 OpenRAG API 调整）
OPENRAG_KNOWLEDGE_FILTER=

# Dify 对比配置
DIFY_BASE_URL=http://localhost
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=
DIFY_RERANK_PROVIDER=langgenius/siliconflow/siliconflow
DIFY_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 评测集路径
EVAL_CSV=configs/eval/fintech-eval.csv

# Dify 资产路径（用于迁移）
DIFY_RAG_LAB_PATH=../dify-rag-lab
DIFY_SAMPLE_DATA_PATH=../dify-rag-lab/sample-data
